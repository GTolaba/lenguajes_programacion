calcular_ruta(Origen, Destino, Camino, DistanciaTotal) :-
    buscar_ruta(Origen, Destino, [Origen], CaminoInvertido, DistanciaTotal),
    reverse(CaminoInvertido, Camino).

buscar_ruta(Destino, Destino, Visitados, Visitados, 0).

buscar_ruta(Actual, Destino, Visitados, CaminoFinal, DistanciaTotal) :-
    Actual \== Destino,
    conexion(Actual, Intermedio, KmSiguiente),
    \+ member(Intermedio, Visitados),
    buscar_ruta(Intermedio, Destino, [Intermedio|Visitados], CaminoFinal, KmRestantes),
    DistanciaTotal is KmSiguiente + KmRestantes.

